{
  "name": "lighting-floor-plan-designer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:preview": "tsc --noEmit && SINGLE_FILE=1 vite build && node scripts/to-artifact.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "catalog:csv": "vite-node scripts/export-catalog.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "konva": "^9.3.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10"
  }
}
